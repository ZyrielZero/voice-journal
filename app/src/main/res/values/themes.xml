<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole UI; this window theme only needs to be
         AppCompat, because androidx.biometric's fingerprint dialog on
         Android 8.x is an AppCompat AlertDialog and crashes under a
         framework theme. The window background matches the dark scheme so
         a cold start does not flash white. -->
    <style name="Theme.VoiceJournal" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>

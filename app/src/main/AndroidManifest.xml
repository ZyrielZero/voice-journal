<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Deliberately no INTERNET permission: nothing in this app can touch
         the network, enforced by the OS. Everything below is local-only
         plumbing for recording with the screen off. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ONNX Runtime's Android library (as of 1.31.0) ships a manifest that
         asks for network access and registers a telemetry initializer.
         Manifests merge, so without these three removals the built app
         would request INTERNET no matter what this file says. They are
         stripped here, and the build fails if the merged manifest ever
         contains them again (verifyNoNetwork in app/build.gradle.kts). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Backup: allowBackup covers Android 11 and older; Android 12+ ignores
         it for device-to-device transfer, so dataExtractionRules excludes
         everything there too. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceJournal"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- See the note on INTERNET above: never let a library start
             telemetry in this process. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <!-- Keeps recording and transcription alive with the screen off.
             microphone is a while-in-use type: this service must only ever be
             started while the app is visible (the Rec tap), never from the
             background. -->
        <service
            android:name=".pipeline.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
